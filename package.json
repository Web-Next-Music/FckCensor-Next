{
	"name": "fckcensor-next",
	"addonName": "FckCensor Next",
	"version": "1.3.0",
	"author": "Diramix",
	"license": "ISC",
	"scripts": {
		"dev": "ymtm dev",
		"build": "ymtm build",
		"build:nm": "ymtm build nextmusic",
		"build:web": "ymtm build web"
	},
	"build": {
		"targets": [
			"nextmusic",
			"web"
		]
	},
	"nextmusic": {
		"tarGz": {
			"artifactName": "${addon.name}_${addon.version}_${build.package}.tar.gz"
		}
	},
	"web": {
		"onefile": {
			"artifactName": "${addon.name}_${addon.version}_${build.package}.user.js"
		},
		"userscript": {
			"grant": ["GM_xmlhttpRequest", "unsafeWindow"],
			"connect": ["api.github.com", "raw.githubusercontent.com"]
		}
	},
	"packageManager": "pnpm@11.4.0",
	"devDependencies": {
		"@diram1x/ymtm": "^3.5.0"
	}
}
