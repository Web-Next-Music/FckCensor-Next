{
	"name": "fckcensor-next",
	"addonName": "FckCensor Next",
	"version": "1.3.1",
	"author": "Diramix",
	"license": "ISC",
	"scripts": {
		"dev": "nmtools dev",
		"build": "nmtools build",
		"build:nm": "nmtools build nextmusic",
		"build:web": "nmtools build web",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run test"
	},
	"build": {
		"targets": ["nextmusic", "web"]
	},
	"nextmusic": {
		"tarGz": {
			"artifactName": "${addon.name}_${addon.version}_${build.package}.tar.gz"
		}
	},
	"web": {
		"userscript": {
			"artifactName": "${addon.name}_${addon.version}_${build.package}.user.js",
			"icon": "https://github.com/Web-Next-Music/FckCensor-Next/blob/main/src/icon.webp?raw=true",
			"grant": ["GM_xmlhttpRequest", "unsafeWindow"],
			"connect": ["api.github.com", "raw.githubusercontent.com"]
		}
	},
	"packageManager": "pnpm@12.11.2",
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@web-next-music/nmtools": "^5.0.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
